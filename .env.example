API_KEY=change-me-to-a-long-secret

# Same PostgreSQL as the Panel server
# Local / docker compose: use localhost (compose remaps DB_HOST to host.docker.internal)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app_db

# engine-service (base URL only — no /api path suffix)
# Local: http://localhost:8000  |  Docker compose overrides to host.docker.internal:8000
ENGINE_BASE_URL=http://localhost:8000
ENGINE_API_KEY=your-engine-api-key-here
ENGINE_TIMEOUT_SECONDS=120

APP_HOST=0.0.0.0
APP_PORT=8000
# Published host port for `docker compose` (scheduler-api already uses 8000)
HHS_HOST_PORT=8001
LOG_PAYLOAD=true

# Amazon S3 (payload archive / download)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
S3_PAYLOAD_PREFIX=hhs/engine-payloads
S3_PRESIGN_EXPIRES_SECONDS=300
