API_KEY=change-me-to-a-long-secret

# Same PostgreSQL as the Panel server
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app_db

# engine-service (base URL only — no /api path suffix)
ENGINE_BASE_URL=http://localhost:8000
ENGINE_API_KEY=your-engine-api-key-here
ENGINE_TIMEOUT_SECONDS=120

APP_HOST=0.0.0.0
APP_PORT=8000
# Published host port for `docker compose` (default 8001)
HHS_HOST_PORT=8001
# Panel Docker network name (must match `docker network ls` for server compose)
HHS_PANEL_NETWORK=server_default
LOG_PAYLOAD=true

# Docker Compose overrides (used inside the container)
# EC2 + Panel server stack (same Docker network):
#   HHS_DB_HOST=db
#   HHS_ENGINE_BASE_URL=http://34.244.104.57/api-engine
#   PANEL_DOCKER_NETWORK=server_default
#   Panel BRIDGE_BASE_URL=http://homehealthscheduler-api:8000
# Local Mac with DB/engine on host:
#   HHS_DB_HOST=host.docker.internal
#   HHS_ENGINE_BASE_URL=http://host.docker.internal:8000
HHS_DB_HOST=host.docker.internal
HHS_ENGINE_BASE_URL=http://host.docker.internal:8000
PANEL_DOCKER_NETWORK=server_default

# Amazon S3 (payload archive / download)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
S3_PAYLOAD_PREFIX=hhs/engine-payloads
S3_PRESIGN_EXPIRES_SECONDS=300
